# macOS
.DS_Store

# Python bytecode -- regenerated on import, never source
__pycache__/
*.py[cod]

# CatBoost writes training logs here on every run
catboost_info/

# Processed data restored from the Zenodo deposit: never commit it
shared/
folds/*/train/
folds/*/calibration/
folds/*/test/
folds/*/fold_info.json
